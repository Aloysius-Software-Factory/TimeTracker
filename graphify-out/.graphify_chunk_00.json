    {
      "id": "timetracker_CSVLogFormat",
      "label": "CSV Log File Format",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "CSV used as zero-dependency data exchange format. TimeTracker writes {yyyy-M-d}-app.csv and {yyyy-M-d}-idle.csv to %%LOCALAPPDATA%%\\\\TimeTracker\\. TimeTrackerDisplay reads and parses them with auto-pair discovery."
    },
    {
      "id": "timetracker_IdleDetection",
      "label": "Idle Detection via Cursor + Keyboard",
      "file_type": "rationale",
      "source_file": "Tracker.cs",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Idle state determined by cumulative cursor movement distance and key press count over a configurable time window (default 3 min). Thresholds stored in app settings: CursorMoveThresholdPixels (2000), KeyInputThreshold (10)."
    },
    {
      "id": "timetracker_PieChartVisualization",
      "label": "Pie Chart Visualization",
      "file_type": "rationale",
      "source_file": "TimeTrackerDisplay/MainForm.cs",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses built-in System.Windows.Forms.DataVisualization.Charting to render two pie charts per day: app usage grouped by application name, and active/idle status breakdown. No NuGet dependencies required."
    },
    {
      "id": "timetracker_AutoPairDiscovery",
      "label": "Auto CSV Pair Discovery",
      "file_type": "rationale",
      "source_file": "TimeTrackerDisplay/CsvData.cs",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "CsvParser.DiscoverPairedFiles() regex-matches filenames {date}-app.csv and {date}-idle.csv to auto-include siblings when user selects one file of a pair."
    },
    {
      "id": "timetracker_WinFormsFramework",
