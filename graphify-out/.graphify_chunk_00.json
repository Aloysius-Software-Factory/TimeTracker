      "rationale": "Both projects target .NET Framework 4.0 using WinForms, maximizing compatibility with Visual Studio 2019 and avoiding additional framework dependencies."
    },
    {
      "id": "timetracker_TimelineBar",
      "label": "Timeline Bar Visualization",
      "file_type": "rationale",
      "source_file": "TimeTrackerDisplay/TimelinePanel.cs",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Custom Panel subclass draws color-coded horizontal timeline: green=active, orange=idle. Second bar shows per-application segments. Hourly tick marks with time labels. Legend in top-left corner."
    }
